# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/
*.bin
*.elf
*.map

# pioarduino / ESP-IDF build artifacts (generated by the ESP32 builds)
.dummy/
managed_components/
sdkconfig
sdkconfig.*
/CMakeLists.txt

# Build output we DO want to keep out of git (CI produces it)
firmware*.bin

# Reference material (proprietary / third-party — not redistributable)
sources/

# Python (daemon / tools)
__pycache__/
*.pyc

# Generated by daemon/install.bat
daemon/run_daemon.vbs

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

.playwright-mcp/

# pioarduino-generated dependency lock
dependencies.lock

/out/
.omc/

# Local WiFi credentials for scripts/join_wifi.sh -- never commit real values,
# only .env.example.
.env

# local tooling, not part of the firmware
.venv-esptool/

# Built release artefacts (published as Release assets, not tracked)
dist/
firmware_backup/

# [BACKUP]-rule working copies (cp -a <f> <f>.bak_$(date +%s)). They are local
# safety nets, not source -- keep them on disk, keep them out of a public repo.
*.bak_*
*.bak2_*

# Agent/editor scratch backups -- never publish (any *bak* suffix variant)
*bak*
*.orig
*.rej
*.old

# Local fleet list for scripts/fleet_audit.sh -- never publish device names
scripts/fleet_units.local

# Generated at build time by scripts/webui_gz.py from src/webui.h.
# Untracked AND ignored on purpose: git_sha.py marks the image dirty on any
# porcelain output, which would make every build fail preflash_check.sh.
src/webui_gz.h

# Fetched on demand by scripts/wx_icons.py (SIL OFL 1.1, upstream erikflowers/weather-icons).
# Not vendored: the script documents the one-line curl that retrieves it.
scripts/weathericons.ttf

# Agent tooling session artifacts (autoharness locks). Never project content, and
# an untracked file here makes git_sha.py stamp the image dirty, which makes
# preflash_check.sh refuse to flash.
.claude/
